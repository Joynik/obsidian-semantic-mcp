# Copy this file to .env when running OSM from the source checkout.
# An installed osm uses settings saved by osm init instead.

# Absolute path to one Obsidian vault.
# For two or more vaults, comment out OBSIDIAN_VAULT above and uncomment ONE line below.
# Separate absolute paths with commas; do not put commas inside vault paths.
# OBSIDIAN_VAULTS=/absolute/path/to/PersonalVault,/absolute/path/to/WorkVault
OBSIDIAN_VAULT=/absolute/path/to/ObsidianVault

# Exclude folders named Archive by default; change the name for your vault.
# Set yes to include their notes in search and wikilinks.
OBSIDIAN_INDEX_ARCHIVE=no
OBSIDIAN_ARCHIVE_FOLDER=Archive

# Watcher mode: auto detects network mounts on macOS, Windows, and Linux.
# Set true to always poll, or false to use native filesystem events.
# VAULT_WATCH_POLLING=auto

# Database backend: qdrant or postgresql. Keep only one backend active.
# Qdrant URL is the HTTP endpoint of the local Qdrant service.
# PostgreSQL instead: comment out the Qdrant pair; uncomment the backend and one DATABASE_URL.
# OSM_DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql://localhost/obsidian_brain
# With a database user and password, use:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/obsidian_brain
OSM_DATABASE_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333

# HTTP endpoint of the Ollama service that serves the embedding model.
OLLAMA_URL=http://localhost:11434

# Exact name of a model already downloaded with Ollama. Keep only one line active.
# Alternative: pull the model with Ollama, then use its exact installed name.
# EMBEDDING_MODEL=nomic-embed-text-v2-moe
# EMBEDDING_MODEL=your-other-ollama-model:tag
# For an existing index, switch models with: osm migrate --embedding-model MODEL
EMBEDDING_MODEL=qwen3-embedding:0.6b

# PostgreSQL text-search language: russian (default), english, or simple.
# Russian/English stem word forms; simple keeps exact words for any language.
# OSM also stores exact words as a fallback when russian or english is selected.
# Changing this value rebuilds only PostgreSQL text-search vectors at next osm run.
# OSM_SEARCH_LANGUAGE=english
# OSM_SEARCH_LANGUAGE=russian
# OSM_SEARCH_LANGUAGE=simple
OSM_SEARCH_LANGUAGE=russian

# Local HTTP port for the dashboard started on demand with osm dashboard (1-65535).
# This does not change the Ollama, Qdrant, or PostgreSQL ports.
DASHBOARD_PORT=8484
